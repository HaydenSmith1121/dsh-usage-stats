{
  "name": "dsh-usage-stats",
  "version": "0.3.0",
  "private": true,
  "description": "Harness token-usage report: provider-reported tokens folded out of this harness's session logs, backed by a grow-only per-session ledger so deleting a session no longer deletes its usage",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "react": "^18.2.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "node scripts/test.mjs",
    "verify:fold": "node scripts/verify-fold.mjs",
    "verify:retention": "node scripts/verify-retention.mjs",
    "verify:host": "node scripts/verify-host.mjs",
    "verify:client": "node scripts/verify-client.mjs",
    "prepare": "node scripts/build.mjs",
    "pack": "node scripts/build.mjs && npm pack"
  }
}
